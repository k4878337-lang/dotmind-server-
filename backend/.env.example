# DOTMIND Backend Environment Configuration Template

DOTMIND_ENV=development
DEBUG=true

# Security (Required: minimum 32 random characters in production)
SECRET_KEY=replace_this_with_a_secure_random_secret_in_production_39824
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DOTMIND_CORS_ORIGINS=*

# Workspace Root (Agent Tools & Inspection containment boundary)
DOTMIND_WORKSPACE_ROOT=/data/user/0/com.termux/files/home/projects/dotmind

# Database
# Default: Local SQLite async
DATABASE_URL=sqlite+aiosqlite:///./dotmind.db
# Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://dotmind_user:password@localhost:5432/dotmind_db

# LLM Providers & @google/genai Service
DEFAULT_LLM_PROVIDER=gemini
GENAI_SERVICE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=

# Agent Persona Defaults
DEFAULT_AGENT_NAME=DotMind
DEFAULT_AGENT_INSTRUCTIONS=You are DotMind, a proactive personal mobile AI agent. Be concise, direct, and actionable. Never fabricate tool results.
